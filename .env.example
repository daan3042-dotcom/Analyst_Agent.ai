# Kopieer dit bestand naar .env en vul je eigen sleutels in.
# .env zelf staat in .gitignore -- committeer die NOOIT.

ANTHROPIC_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
FMP_API_KEY=
VOYAGE_API_KEY=

# LET OP: deze agent draaide tot nu toe met sleutels als permanente Windows-
# omgevingsvariabelen (PowerShell), niet via een .env-bestand. Als je een
# .env-bestand wilt gebruiken i.p.v. losse omgevingsvariabelen, heb je een
# klein stukje extra code nodig (bijv. python-dotenv) om dit bestand
# daadwerkelijk in te lezen -- dat zit nu nog niet in de code.
